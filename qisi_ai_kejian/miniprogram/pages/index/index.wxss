.home {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 64rpx;
  background:
    radial-gradient(90% 55% at 85% -5%, rgba(167, 139, 250, 0.22), transparent 55%),
    radial-gradient(70% 45% at 0% 30%, rgba(125, 211, 252, 0.16), transparent 50%),
    linear-gradient(180deg, #f3f0f8 0%, #ebe7f2 48%, #e6e2ec 100%);
}

.home-header {
  margin-bottom: 36rpx;
  padding-top: 8rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #8b7cf6, #5b4adb);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(91, 74, 219, 0.28);
}

.brand-badge-inner {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  transform: rotate(18deg);
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2a2540;
  letter-spacing: 0.02em;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.feature-tile {
  width: calc(50% - 12rpx);
  min-height: 280rpx;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 14rpx 36rpx rgba(60, 48, 120, 0.12);
  position: relative;
  overflow: hidden;
}

.feature-tile::after {
  content: "";
  position: absolute;
  right: -40rpx;
  bottom: -48rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.tile-pressed {
  opacity: 0.92;
  transform: scale(0.985);
}

.tile-ppt {
  background: linear-gradient(145deg, #b39bff 0%, #8b6cf5 42%, #5f4ae6 100%);
}

.tile-exam {
  background: linear-gradient(145deg, #7dd3fc 0%, #38bdf8 40%, #14b8a6 100%);
}

.tile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.tile-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.ai-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 14rpx 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.ai-spark {
  color: #fde047;
  font-size: 20rpx;
  margin-right: 2rpx;
}

.ai-label {
  font-weight: 600;
  letter-spacing: 0.04em;
}

.ai-chevron {
  font-size: 26rpx;
  font-weight: 500;
  opacity: 0.95;
  margin-left: 2rpx;
}

.tile-body {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
}

.tile-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.tile-sub {
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.35;
}

/* Presentation board icon */
.icon-board {
  width: 40rpx;
  height: 36rpx;
  position: relative;
}

.icon-board-screen {
  width: 36rpx;
  height: 24rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.icon-board-stand {
  width: 3rpx;
  height: 8rpx;
  background: #fff;
  margin: 0 auto;
}

.icon-board-base {
  width: 18rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
  margin: 0 auto;
}

/* Exam / doc icon */
.icon-exam {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.icon-exam-sheet {
  width: 28rpx;
  height: 34rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  box-sizing: border-box;
  padding: 6rpx 4rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.icon-exam-line {
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
  width: 100%;
  opacity: 0.95;
}

.icon-exam-line.short {
  width: 65%;
}

.icon-exam-check {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(20, 184, 166, 0.35);
}

.icon-exam-check::after {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 2rpx;
  width: 6rpx;
  height: 4rpx;
  border-left: 2rpx solid #14b8a6;
  border-bottom: 2rpx solid #14b8a6;
  transform: rotate(-45deg);
}

.home-foot {
  margin-top: 40rpx;
  text-align: center;
  color: rgba(42, 37, 64, 0.45);
  font-size: 22rpx;
}
