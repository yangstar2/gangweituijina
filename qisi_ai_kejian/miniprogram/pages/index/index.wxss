.hero {
  min-height: 100vh;
  padding: 120rpx 48rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    linear-gradient(165deg, rgba(27, 58, 87, 0.08) 0%, transparent 42%),
    radial-gradient(80% 50% at 90% 10%, rgba(196, 92, 38, 0.18), transparent 60%);
}

.brand {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--ink);
  margin-bottom: 28rpx;
}

.tagline {
  font-size: 32rpx;
  color: var(--ink-soft);
  max-width: 560rpx;
  margin-bottom: 64rpx;
}

.cta-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.cta-row .btn-primary {
  flex: 1;
}

.hint {
  margin-top: 24rpx;
}
