.page { padding: 40rpx 36rpx 100rpx; }
.status { margin-bottom: 28rpx; font-size: 28rpx; }
.plan {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: rgba(255,255,255,0.55);
}
.plan.active { border-color: var(--ink); background: #fff; }
.name { font-weight: 600; font-size: 30rpx; margin-bottom: 8rpx; }
.desc { color: var(--ink-soft); font-size: 24rpx; margin-bottom: 12rpx; }
.feat { font-size: 24rpx; color: var(--ink-soft); }
.buy { margin-top: 40rpx; }
.tip { margin-top: 20rpx; text-align: center; }
