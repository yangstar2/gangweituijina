.page {
  padding: 32rpx 28rpx 80rpx;
}

.meta {
  margin-bottom: 20rpx;
}

.pager {
  height: 720rpx;
}

.slide {
  height: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(160deg, #ffffff 0%, #f7f4ec 100%);
  border: 1rpx solid var(--line);
}

.page-no {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-bottom: 20rpx;
}

.slide-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.bullet {
  margin-bottom: 12rpx;
  color: var(--ink-soft);
}

.note {
  margin-top: 36rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 24rpx;
  color: var(--accent);
}

.hint {
  margin-top: 24rpx;
  font-size: 22rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.actions > view {
  flex: 1;
}

.gen {
  margin-top: 28rpx;
}

.done {
  margin-top: 28rpx;
  text-align: center;
}
