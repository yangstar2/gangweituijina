.page {
  padding: 40rpx 40rpx 120rpx;
}

.style-row {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  margin-top: 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.55);
}

.style-row.active {
  border-color: var(--ink);
  background: #fff;
}

.swatches {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.swatch {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.meta {
  flex: 1;
}

.name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 6rpx;
}

.desc {
  color: var(--ink-soft);
  font-size: 24rpx;
}

.next {
  margin-top: 48rpx;
}
