.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.messages {
  flex: 1;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.bubble-row {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid var(--line);
}

.bubble-row.user .bubble {
  background: var(--ink);
  color: #fff;
  border-color: transparent;
}

.role-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.65;
  margin-bottom: 8rpx;
}

.bubble-text {
  font-size: 28rpx;
  white-space: pre-wrap;
}

.suggest {
  padding: 0 28rpx 12rpx;
}

.composer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(243, 240, 232, 0.95);
}

.input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--line);
}

.send {
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
}

.footer-bar {
  padding: 12rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(243, 240, 232, 0.98);
  border-top: 1rpx solid var(--line);
}
