.think-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(90% 55% at 100% -10%, rgba(76, 140, 180, 0.22), transparent 55%),
    radial-gradient(70% 45% at -10% 15%, rgba(196, 92, 38, 0.14), transparent 50%),
    linear-gradient(180deg, #f4f7fb 0%, #eef3f7 48%, #e7edf2 100%);
}

.hero {
  padding: 8rpx 4rpx 28rpx;
  animation: rise 0.5s ease-out;
}

.hero-kicker {
  display: inline-block;
  font-size: 22rpx;
  color: #4a6078;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1b3a57;
  letter-spacing: 0.02em;
  margin-bottom: 10rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #4a6078;
  line-height: 1.5;
}

.step-rail {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  border-radius: 20rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(8px);
  animation: rise 0.55s ease-out;
}

.step-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 12rpx;
  opacity: 0.45;
  transition: opacity 0.25s ease;
}

.step-item.done,
.step-item.active {
  opacity: 1;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  background: #c5cdd6;
  position: relative;
  flex-shrink: 0;
}

.step-item.active .step-dot {
  background: #c45c26;
  box-shadow: 0 0 0 6rpx rgba(196, 92, 38, 0.18);
}

.step-item.done .step-dot {
  background: #2f6b4f;
}

.step-pulse {
  position: absolute;
  inset: -10rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(196, 92, 38, 0.35);
  animation: pulse 1.4s ease-out infinite;
}

@keyframes pulse {
  0% { transform: scale(0.7); opacity: 0.9; }
  100% { transform: scale(1.5); opacity: 0; }
}

.step-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b3a57;
}

.step-detail {
  font-size: 24rpx;
  color: #4a6078;
  margin-top: 4rpx;
  line-height: 1.45;
}

.think-panel {
  background: linear-gradient(160deg, #152a3d 0%, #1b3a57 55%, #243f5c 100%);
  color: #e8eef4;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(27, 58, 87, 0.22);
  animation: rise 0.6s ease-out;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.panel-badge {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(232, 238, 244, 0.35);
  color: #c9d6e2;
}

.panel-badge.open {
  background: rgba(255, 255, 255, 0.08);
}

.think-scroll {
  max-height: 420rpx;
}

.think-text {
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  color: #d7e2ec;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.think-preview {
  font-size: 24rpx;
  color: #a8b8c8;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.caret {
  display: inline-block;
  width: 12rpx;
  height: 28rpx;
  margin-left: 4rpx;
  vertical-align: text-bottom;
  background: #e8a87c;
  opacity: 0;
}

.caret.blink {
  opacity: 1;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.outline-card {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  margin-bottom: 24rpx;
  animation: rise 0.45s ease-out;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.olist {
  margin-top: 8rpx;
}

.oitem,
.osec {
  font-size: 26rpx;
  color: #1b3a57;
  line-height: 1.55;
}

.osec {
  font-weight: 600;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ophase {
  font-size: 20rpx;
  font-weight: 600;
  color: #c45c26;
  background: rgba(196, 92, 38, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.err {
  color: #a33b2b;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .btn-primary,
.actions .btn-accent {
  flex: 1;
}

.actions .disabled {
  opacity: 0.55;
  pointer-events: none;
}

.slide-preview-card {
  background: rgba(255, 255, 255, 0.86);
  border-radius: 20rpx;
  padding: 24rpx 20rpx 12rpx;
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  margin-bottom: 24rpx;
  animation: rise 0.45s ease-out;
}

.preview-phase {
  font-size: 22rpx;
  font-weight: 400;
}

.preview-pager {
  height: 600rpx;
  margin-top: 12rpx;
}

.preview-slide {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx 28rpx 20rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #ffffff 0%, #f3f6f9 100%);
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  animation: slideIn 0.5s ease-out;
}

.slide-glow {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -80rpx;
  border-radius: 50%;
  background: rgba(76, 140, 180, 0.16);
  pointer-events: none;
  animation: floatGlow 3.6s ease-in-out infinite;
}

@keyframes floatGlow {
  0%, 100% { transform: translateY(0); opacity: 0.7; }
  50% { transform: translateY(12rpx); opacity: 1; }
}

@keyframes slideIn {
  from { opacity: 0; transform: scale(0.98) translateY(8rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.preview-slide.layout-cover {
  background: linear-gradient(155deg, #152a3d 0%, #1b3a57 55%, #2a4d6e 100%);
  color: #e8eef4;
  border: none;
}
.preview-slide.layout-cover .slide-title,
.preview-slide.layout-cover .page-no,
.preview-slide.layout-cover .sub,
.preview-slide.layout-cover .bullet {
  color: #e8eef4;
}
.preview-slide.layout-cover .bmark,
.preview-slide.layout-cover .note {
  color: #e8a87c;
}
.preview-slide.layout-cover .slide-glow {
  background: rgba(196, 92, 38, 0.28);
}

.preview-slide.layout-section {
  background: linear-gradient(120deg, #1b3a57 0 34%, #f7fafc 34% 100%);
}
.preview-slide.layout-section .slide-title {
  color: #1b3a57;
  margin-left: 36%;
}
.preview-slide.layout-section .sub,
.preview-slide.layout-section .bullet,
.preview-slide.layout-section .page-meta {
  margin-left: 36%;
}

.preview-slide.layout-example {
  background: linear-gradient(165deg, #fff8f3 0%, #ffffff 45%, #f3f7fb 100%);
  border-left: 8rpx solid #c45c26;
}

.preview-slide.layout-practice {
  background: linear-gradient(165deg, #f3faf6 0%, #ffffff 50%, #f3f7fb 100%);
  border-left: 8rpx solid #2f6b4f;
}

.preview-slide.layout-summary,
.preview-slide.layout-homework {
  background: linear-gradient(180deg, #f7fafc 0%, #eef3f7 70%, #1b3a57 70% 100%);
}
.preview-slide.layout-summary .note,
.preview-slide.layout-homework .note {
  color: #e8a87c;
  border-top-color: rgba(232, 238, 244, 0.25);
}

.preview-slide.layout-agenda {
  background: linear-gradient(180deg, #1b3a57 0 22%, #ffffff 22% 100%);
}
.preview-slide.layout-agenda .page-meta,
.preview-slide.layout-agenda .slide-title {
  color: #e8eef4;
}
.preview-slide.layout-agenda .sub,
.preview-slide.layout-agenda .bullet {
  margin-top: 8rpx;
  color: #1b3a57;
}
.preview-slide.layout-agenda .bmark {
  color: #c45c26;
}

.page-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.page-no {
  font-size: 22rpx;
  color: #4a6078;
}

.phase-chip {
  font-size: 20rpx;
  color: #c45c26;
  background: rgba(196, 92, 38, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.layout-cover .phase-chip {
  background: rgba(232, 168, 124, 0.2);
  color: #e8a87c;
}

.slide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1b3a57;
  margin-bottom: 12rpx;
}

.sub {
  font-size: 24rpx;
  color: #4a6078;
  margin-bottom: 16rpx;
}

.bullet {
  font-size: 26rpx;
  color: #4a6078;
  margin-bottom: 10rpx;
  line-height: 1.45;
}

.bmark {
  color: #c45c26;
  font-weight: 700;
  margin-right: 6rpx;
}

.note {
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(27, 58, 87, 0.15);
  font-size: 22rpx;
  color: #c45c26;
}
