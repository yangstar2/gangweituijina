.think-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(90% 55% at 100% -10%, rgba(76, 140, 180, 0.18), transparent 55%),
    radial-gradient(70% 45% at -10% 15%, rgba(196, 92, 38, 0.1), transparent 50%),
    linear-gradient(180deg, #f7f4ec 0%, #efe9dc 55%, #e7e1d3 100%);
}

.hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-kicker {
  display: inline-block;
  font-size: 22rpx;
  color: #4a6078;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1b3a57;
  letter-spacing: 0.02em;
  margin-bottom: 10rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #4a6078;
  line-height: 1.5;
}

.step-rail {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  border-radius: 20rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  margin-bottom: 24rpx;
}

.step-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 12rpx;
  opacity: 0.45;
  transition: opacity 0.25s ease;
}

.step-item.done,
.step-item.active {
  opacity: 1;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  background: #c5cdd6;
  position: relative;
  flex-shrink: 0;
}

.step-item.active .step-dot {
  background: #c45c26;
  box-shadow: 0 0 0 6rpx rgba(196, 92, 38, 0.18);
}

.step-item.done .step-dot {
  background: #2f6b4f;
}

.step-pulse {
  position: absolute;
  inset: -10rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(196, 92, 38, 0.35);
  animation: pulse 1.4s ease-out infinite;
}

@keyframes pulse {
  0% { transform: scale(0.7); opacity: 0.9; }
  100% { transform: scale(1.5); opacity: 0; }
}

.step-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b3a57;
}

.step-detail {
  font-size: 24rpx;
  color: #4a6078;
  margin-top: 4rpx;
  line-height: 1.45;
}

.think-panel {
  background: #1b3a57;
  color: #e8eef4;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(27, 58, 87, 0.18);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.panel-badge {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(232, 238, 244, 0.35);
  color: #c9d6e2;
}

.panel-badge.open {
  background: rgba(255, 255, 255, 0.08);
}

.think-scroll {
  max-height: 420rpx;
}

.think-text {
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  color: #d7e2ec;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.think-preview {
  font-size: 24rpx;
  color: #a8b8c8;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.caret {
  display: inline-block;
  width: 12rpx;
  height: 28rpx;
  margin-left: 4rpx;
  vertical-align: text-bottom;
  background: #e8a87c;
  opacity: 0;
}

.caret.blink {
  opacity: 1;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.outline-card {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  margin-bottom: 24rpx;
  animation: rise 0.45s ease-out;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.olist {
  margin-top: 8rpx;
}

.oitem,
.osec {
  font-size: 26rpx;
  color: #1b3a57;
  line-height: 1.55;
}

.osec {
  font-weight: 600;
  margin-top: 8rpx;
}

.err {
  color: #a33b2b;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .btn-primary,
.actions .btn-accent {
  flex: 1;
}

.actions .disabled {
  opacity: 0.55;
  pointer-events: none;
}

.slide-preview-card {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 20rpx;
  padding: 24rpx 20rpx 12rpx;
  border: 1rpx solid rgba(27, 58, 87, 0.08);
  margin-bottom: 24rpx;
  animation: rise 0.45s ease-out;
}

.preview-phase {
  font-size: 22rpx;
  font-weight: 400;
}

.preview-pager {
  height: 560rpx;
  margin-top: 12rpx;
}

.preview-slide {
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx 28rpx 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f7f4ec 100%);
  border: 1rpx solid rgba(27, 58, 87, 0.08);
}

.preview-slide .page-no {
  font-size: 22rpx;
  color: #4a6078;
  margin-bottom: 14rpx;
}

.preview-slide .slide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1b3a57;
  margin-bottom: 12rpx;
}

.preview-slide .sub {
  font-size: 24rpx;
  color: #4a6078;
  margin-bottom: 16rpx;
}

.preview-slide .bullet {
  font-size: 26rpx;
  color: #4a6078;
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.preview-slide .note {
  margin-top: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(27, 58, 87, 0.15);
  font-size: 22rpx;
  color: #c45c26;
}
