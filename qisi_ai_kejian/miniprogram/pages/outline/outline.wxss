.page {
  padding: 40rpx 40rpx 120rpx;
}

.list {
  margin-bottom: 40rpx;
}

.item {
  margin-bottom: 10rpx;
  color: var(--ink-soft);
}

.item.note {
  color: var(--accent);
}

.section-block {
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.sec-name {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.actions > view {
  flex: 1;
}
