page {
  --ink: #1b3a57;
  --ink-soft: #4a6078;
  --paper: #f3f0e8;
  --paper-deep: #e6e0d2;
  --accent: #c45c26;
  --accent-soft: #e8a87c;
  --line: rgba(27, 58, 87, 0.12);
  --ok: #2f6b4f;

  background: radial-gradient(120% 80% at 10% -10%, #fff8ee 0%, var(--paper) 45%, #e8e4da 100%);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  min-height: 100%;
}

.btn-primary {
  background: var(--ink);
  color: #fff;
  border-radius: 12rpx;
  padding: 22rpx 36rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-primary.ghost {
  background: transparent;
  color: var(--ink);
  border: 2rpx solid var(--ink);
}

.btn-accent {
  background: var(--accent);
  color: #fff;
  border-radius: 12rpx;
  padding: 22rpx 36rpx;
  font-size: 30rpx;
  text-align: center;
}

.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 8rpx;
  background: var(--paper-deep);
  color: var(--ink-soft);
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin-bottom: 12rpx;
}

.muted {
  color: var(--ink-soft);
  font-size: 24rpx;
}
